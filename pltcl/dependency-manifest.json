{
  "image": "pltcl",
  "postgresql_major": 18,
  "debian_suites": [
    "bookworm",
    "trixie"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "upstream": {
    "url": "https://www.postgresql.org/docs/18/pltcl.html",
    "license_spdx": [
      "PostgreSQL",
      "TCL"
    ]
  },
  "runtime_dependencies": {
    "bookworm": {
      "extension_package": {
        "name": "postgresql-pltcl-18",
        "version": "18.6-1.pgdg12+2",
        "source_package": "postgresql-18",
        "source_version": "18.6-1.pgdg12+2",
        "origin": "https://apt.postgresql.org/pub/repos/apt bookworm-pgdg/main"
      },
      "additional_runtime_packages": [
        {
          "name": "libtcl8.6",
          "version": "8.6.13+dfsg-2",
          "source_package": "tcl8.6",
          "source_version": "8.6.13+dfsg-2",
          "origin": "Debian main"
        }
      ],
      "base_runtime_packages": [
        {
          "name": "postgresql-18",
          "version": "18.6-1.pgdg12+2",
          "source_package": "postgresql-18",
          "source_version": "18.6-1.pgdg12+2",
          "origin": "PGDG CNPG base image"
        },
        {
          "name": "libc6",
          "version": "2.36-9+deb12u14",
          "source_package": "glibc",
          "source_version": "2.36-9+deb12u14",
          "origin": "Debian base image"
        },
        {
          "name": "zlib1g",
          "version": "1:1.2.13.dfsg-1",
          "source_package": "zlib",
          "source_version": "1:1.2.13.dfsg-1",
          "origin": "Debian base image"
        }
      ],
      "dynamic_libraries_required": [
        "libtcl8.6.so (bundled from Debian libtcl8.6)",
        "libz.so.1 (provided by base image)",
        "libm.so.6 and libc.so.6 (provided by base image)"
      ]
    },
    "trixie": {
      "extension_package": {
        "name": "postgresql-pltcl-18",
        "version": "18.6-1.pgdg13+2",
        "source_package": "postgresql-18",
        "source_version": "18.6-1.pgdg13+2",
        "origin": "https://apt.postgresql.org/pub/repos/apt trixie-pgdg/main"
      },
      "additional_runtime_packages": [
        {
          "name": "libtcl8.6",
          "version": "8.6.16+dfsg-1",
          "source_package": "tcl8.6",
          "source_version": "8.6.16+dfsg-1",
          "origin": "Debian main"
        }
      ],
      "base_runtime_packages": [
        {
          "name": "postgresql-18",
          "version": "18.6-1.pgdg13+2",
          "source_package": "postgresql-18",
          "source_version": "18.6-1.pgdg13+2",
          "origin": "PGDG CNPG base image"
        },
        {
          "name": "libc6",
          "version": "2.41-12+deb13u4",
          "source_package": "glibc",
          "source_version": "2.41-12+deb13u4",
          "origin": "Debian base image"
        },
        {
          "name": "zlib1g",
          "version": "1:1.3.dfsg+really1.3.1-1+b1",
          "source_package": "zlib",
          "source_version": "1:1.3.dfsg+really1.3.1-1",
          "origin": "Debian base image"
        }
      ],
      "dynamic_libraries_required": [
        "libtcl8.6.so (bundled from Debian libtcl8.6)",
        "libz.so.1 (provided by base image)",
        "libm.so.6 and libc.so.6 (provided by base image)"
      ]
    }
  },
  "pgdg_source_package": "postgresql-18",
  "runtime_manifest_in_image": "/licenses/runtime-packages.tsv",
  "bundled_or_static_components": [
    {
      "name": "Tcl interpreter/runtime",
      "version": "8.6",
      "license_spdx": "TCL",
      "linkage": "libtcl8.6.so copied into /lib; Tcl standard library copied to /share/tcl8.6 and selected through TCL_LIBRARY",
      "update_path": "Debian packages Tcl separately from the PGDG PostgreSQL PL/Tcl module. Review libtcl8.6 and tcl8.6 source/copyright on updates, and rerun both trusted and untrusted fixtures."
    }
  ],
  "source_archives_in_image": {
    "path": "/source/",
    "source_packages": {
      "pltcl": "postgresql-18, exact installed source:Version",
      "tcl": "tcl8.6, exact installed source:Version"
    },
    "contents": "Exact PGDG PostgreSQL source for the PL/Tcl binary and exact Debian Tcl source, including .dsc and upstream/Debian archives."
  },
  "license_payload": [
    "/licenses/postgresql-pltcl/copyright",
    "/licenses/libtcl8.6/copyright",
    "/licenses/GPL-1",
    "/licenses/Artistic"
  ],
  "update_and_rebuild_path": "Renovate tracks the PGDG postgresql-pltcl-18 package in metadata.hcl. Debian updates libtcl8.6 separately. Rebuild on either update, review both copyright/source packages and test that Tcl core scripts load from the image-volume path."
}
