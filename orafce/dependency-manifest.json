{
  "image": "orafce",
  "postgresql_major": 18,
  "debian_suites": [
    "bookworm",
    "trixie"
  ],
  "architectures": [
    "amd64",
    "arm64"
  ],
  "upstream": {
    "url": "https://github.com/orafce/orafce",
    "license_spdx": [
      "0BSD",
      "GPL-3.0-or-later WITH Bison-exception-2.2"
    ]
  },
  "pgdg_source_package": "orafce",
  "runtime_dependencies": [
    {
      "suite": "bookworm",
      "base_image": "ghcr.io/cloudnative-pg/postgresql:18-minimal-bookworm",
      "extension_package": {
        "name": "postgresql-18-orafce",
        "version": "4.16.12-1.pgdg12+1",
        "origin": "https://apt.postgresql.org/pub/repos/apt bookworm-pgdg/main"
      },
      "base_runtime_packages": [
        {
          "name": "postgresql-18",
          "version": "18.6-1.pgdg12+2",
          "license": "PostgreSQL"
        },
        {
          "name": "libc6",
          "version": "2.36-9+deb12u14",
          "license": "LGPL-2.1-or-later; see the base image package copyright"
        }
      ],
      "dynamic_libraries_required": [
        "libc.so.6"
      ]
    },
    {
      "suite": "trixie",
      "base_image": "ghcr.io/cloudnative-pg/postgresql:18-minimal-trixie",
      "extension_package": {
        "name": "postgresql-18-orafce",
        "version": "4.16.12-1.pgdg13+1",
        "origin": "https://apt.postgresql.org/pub/repos/apt trixie-pgdg/main"
      },
      "base_runtime_packages": [
        {
          "name": "postgresql-18",
          "version": "18.6-1.pgdg13+2",
          "license": "PostgreSQL"
        },
        {
          "name": "libc6",
          "version": "2.41-12+deb13u4",
          "license": "LGPL-2.1-or-later; see the base image package copyright"
        }
      ],
      "dynamic_libraries_required": [
        "libc.so.6"
      ]
    }
  ],
  "bundled_or_static_components": [
    {
      "name": "sqlparse parser",
      "version": "as packaged in PGDG orafce 4.16.12-1",
      "license": "GPL-3.0-or-later WITH Bison-exception-2.2",
      "linkage": "source compiled into orafce.so",
      "files": "sqlparse.c, sqlparse.h",
      "update_path": "Renovate tracks PGDG orafce; exact corresponding source archives are shipped under /source/."
    }
  ],
  "source_archives_in_image": {
    "path": "/source/",
    "source_package": "orafce",
    "versions": {
      "bookworm": "4.16.12-1.pgdg12+1",
      "trixie": "4.16.12-1.pgdg13+1"
    },
    "contents": "PGDG .dsc, upstream orig archive, Debian packaging archive"
  },
  "update_and_rebuild_path": "Renovate tracks the version-pinned PGDG binary package in metadata.hcl. Rebuild the image on package updates; review the matching package source, dependency versions, control and copyright. No runtime package installation is required.",
  "license_payload": [
    "/licenses/postgresql-18-orafce/copyright",
    "/licenses/GPL-3"
  ],
  "runtime_manifest_in_image": {
    "path": "/licenses/runtime-packages.tsv",
    "generated_from": "dpkg-query for the installed extension package, postgresql-${PG_MAJOR}, and Debian packages that own every resolved ldd library path",
    "fields": [
      "binary_package",
      "version",
      "source_package",
      "source_version"
    ]
  }
}
