{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "customManagers:githubActionsVersions",
    ":gitSignOff",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": [],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "updates the deb package versions in the metadata.hcl files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.hcl"
      ],
      "matchStrings": [
        "\\/\\/\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*(sql|package)\\s*=\\s*\"(?<currentValue>.*)\""
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the container image versions in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?\\s*reference: ghcr.io\\/cnpg-extensions\\/[A-Za-z0-9_-]+:(?<currentValue>(?:[0-9]+-)?([0-9]\\.?)+)"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb",
      "currentValueTemplate": "{{{replace '-' ':' currentValue}}}",
      "extractVersionTemplate": "^(?<version>[^-+~]+)",
      "autoReplaceStringTemplate": "{{{replace (replace ':' '-' currentValue) (replace ':' '-' newValue) replaceString}}}"
    },
    {
      "description": "updates the container image SQL version in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*version: '(?<currentValue>([0-9]\\.?)+)'"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the Taskfile, test files and GitHub Actions workflow dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "Taskfile.yml",
        ".github/workflows/*.yml",
        "**/test/*.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:]+\\s*:\\s*[\"']?(?:[a-zA-Z0-9._/-]+:)?(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the dagger dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "dagger/**/*.go"
      ],
      "matchStrings": [
        "\\/\\/\\s+renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))\\s+\\/\\/\\s+\\+default=[\\\"']?[^:]+?:(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the SBOM generator base image",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?\\s+FROM\\s+(?:[a-zA-Z0-9._/-]+:)?(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?"
      ]
    },
    {
      "description": "updates the SBOM generator Dockerfile frontend",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "# syntax=docker/dockerfile:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "docker/dockerfile",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "updates the SBOM generator tool versions",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "description": "PGRX source tags; companion source and Cargo locks are refreshed together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(pg-durable|pg-graphql|pg-jsonschema|pg-parquet|pg-search|pg-session-jwt)/metadata\\.hcl$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>github-tags)\\s+depName=(?<depName>\\S+)\\s+versioning=(?<versioning>\\S+)\\s+package\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "description": "PGRX workflow/build tool releases (refresh all platform checksums before merge)",
      "customType": "regex",
      "managerFilePatterns": [
        "/pgrx/dependencies/(workflow-tools|tools)\\.json$/"
      ],
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\"\\s*,\\s*\"depName\":\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*\"datasource\":\\s*\"(?<datasource>[^\"]+)\"",
        "\"version\":\\s*\"(?<currentValue>[^\"]+)\"\\s*,\\s*\"datasource\":\\s*\"(?<datasource>[^\"]+)\"\\s*,\\s*\"depName\":\\s*\"(?<depName>[^\"]+)\""
      ]
    },
    {
      "description": "PGRX digest-pinned execution images",
      "customType": "regex",
      "managerFilePatterns": [
        "/pgrx/dependencies/workflow-tools\\.json$/"
      ],
      "matchStrings": [
        "\"[a-z-]+\":\\s*\"(?<depName>[^\"\\s]+):(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "PGRX base indexes own both platform children and apt package locks",
      "customType": "regex",
      "managerFilePatterns": [
        "/pgrx/dependencies/bases\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>[^\"\\s]+):(?<currentValue>[^\"@\\s]+)\":\\s*\\{\\s*\"index_digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "PGRX CNPG operator/catalog fixture commits; refresh URLs and checksums together",
      "customType": "regex",
      "managerFilePatterns": [
        "/pgrx/dependencies/fixtures/lock\\.json$/"
      ],
      "matchStrings": [
        "\"repository\":\\s*\"(?<packageName>[^\"\\s]+)\",\\s*\"ref\":\\s*\"(?<currentValue>[^\"\\s]+)\",\\s*\"revision\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "depNameTemplate": "https://github.com/{{{packageName}}}",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "description": "updates the SPDX validation tool",
      "customType": "regex",
      "managerFilePatterns": [
        "sbom-generator/requirements-validation.txt"
      ],
      "matchStrings": [
        "#\\s*renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+spdx-tools==(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "require manual review for mysql-fdw updates",
      "matchPackageNames": [
        "postgresql-18-mysql-fdw"
      ],
      "automerge": false,
      "prBodyNotes": [
        "\u26a0\ufe0f Current MySQL FDW SQL extension version is 1.2. It changed from 1.1 to 1.2 on October 14, 2022 (first included in package version 2.9.0). Manually check the upstream repository to see whether the SQL extension version changed before merging this package update. If it changed, manually update mysql-fdw/README.md, mysql-fdw/metadata.hcl, and renovate.json."
      ]
    },
    {
      "description": "require manual review for pldebugger updates",
      "matchPackageNames": [
        "postgresql-18-pldebugger"
      ],
      "automerge": false,
      "prBodyNotes": [
        "\u26a0\ufe0f Current PL/Debugger SQL extension version is 1.1. It changed from 1.0 to 1.1 on June 25, 2018 (first included in upstream release v1.3). The Debian package version is currently 1:1.10. Renovate updates the package and image references only. Manually check the upstream repository to see whether the SQL extension version changed before merging this package update. If it changed, manually update pldebugger/README.md, pldebugger/metadata.hcl, and renovate.json."
      ]
    },
    {
      "description": "require stable release verification for all updates",
      "matchPackageNames": [
        "*"
      ],
      "prBodyNotes": [
        "\u26a0\ufe0f Before approving this PR, confirm that the new extension version is a stable release, not a beta or release candidate."
      ]
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github action",
      "pinDigests": true,
      "matchPackageNames": [
        "!microsoft/pg_durable",
        "!supabase/pg_graphql",
        "!supabase/pg_jsonschema",
        "!CrunchyData/pg_parquet",
        "!paradedb/paradedb",
        "!neondatabase/pg_session_jwt"
      ]
    },
    {
      "description": "PGRX release updates require coupled immutable lock refresh",
      "matchFileNames": [
        "pgrx/dependencies/**",
        "pg-durable/metadata.hcl",
        "pg-graphql/metadata.hcl",
        "pg-jsonschema/metadata.hcl",
        "pg-parquet/metadata.hcl",
        "pg-search/metadata.hcl",
        "pg-session-jwt/metadata.hcl"
      ],
      "automerge": false,
      "prBodyNotes": [
        "Run python3 pgrx/refresh_lock.py --check after refreshing the affected checksums. Source tags, resolved commits, archives and upstream Cargo.lock are one update; SQL version changes require review."
      ]
    },
    {
      "description": "cargo-cyclonedx releases have a tool-specific tag prefix",
      "matchPackageNames": [
        "CycloneDX/cyclonedx-rust-cargo"
      ],
      "extractVersion": "^cargo-cyclonedx-(?<version>.*)$"
    },
    {
      "description": "review SPDX validator upgrades with ScanCode dependency compatibility",
      "matchPackageNames": [
        "spdx-tools",
        "scancode-toolkit"
      ],
      "groupName": "SBOM validation dependencies",
      "automerge": false,
      "prBodyNotes": [
        "⚠️ Check that the selected SPDX Tools release is compatible with the ScanCode Toolkit release. The current ScanCode Toolkit pins spdx-tools==0.8.2."
      ]
    },
    {
      "description": "group cnpg-sbom-generator image digest updates and require review",
      "matchPackageNames": [
        "/^ghcr\\.io\\/[^/]+\\/cnpg-sbom-generator$/"
      ],
      "groupName": "cnpg-sbom-generator image digests",
      "automerge": false
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github action",
      "pinDigests": true
    }
  ]
}
