{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "customManagers:githubActionsVersions",
    ":gitSignOff",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": [],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "updates the deb package versions in the metadata.hcl files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.hcl"
      ],
      "matchStrings": [
        "\\/\\/\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*(sql|package)\\s*=\\s*\"(?<currentValue>.*)\""
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the container image versions in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?\\s*reference: ghcr.io\\/cnpg-extensions\\/[A-Za-z0-9_-]+:(?<currentValue>(?:[0-9]+-)?([0-9]\\.?)+)"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb",
      "currentValueTemplate": "{{{replace '-' ':' currentValue}}}",
      "extractVersionTemplate": "^(?<version>[^-+~]+)",
      "autoReplaceStringTemplate": "{{{replace (replace ':' '-' currentValue) (replace ':' '-' newValue) replaceString}}}"
    },
    {
      "description": "updates the container image SQL version in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*version: '(?<currentValue>([0-9]\\.?)+)'"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the Taskfile, test files and GitHub Actions workflow dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "Taskfile.yml",
        ".github/workflows/*.yml",
        "**/test/*.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:]+\\s*:\\s*[\"']?(?:[a-zA-Z0-9._\/-]+:)?(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the dagger dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "dagger/**/*.go"
      ],
      "matchStrings": [
        "\\/\\/\\s+renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))\\s+\\/\\/\\s+\\+default=[\\\"']?[^:]+?:(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "require stable release verification for all updates",
      "matchPackageNames": [
        "*"
      ],
      "prBodyNotes": [
        "⚠️ Before approving this PR, confirm that the new extension version is a stable release, not a beta or release candidate."
      ]
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github action",
      "pinDigests": true
    },
    {
      "description": "require SQL version review when no verified package mapping covers all shipped extensions",
      "matchPackageNames": [
        "postgresql-*-credcheck",
        "postgresql-*-jsquery",
        "postgresql-*-mysql-fdw",
        "postgresql-*-pg-csv",
        "postgresql-*-pglogical",
        "postgresql-*-pgmp",
        "postgresql-*-pgpcre",
        "postgresql-*-pgtt",
        "postgresql-*-pldebugger",
        "postgresql-*-pllua",
        "postgresql-*-plsh",
        "postgresql-*-prefix",
        "postgresql-*-preprepare",
        "postgresql-*-rdkit",
        "postgresql-*-similarity",
        "postgresql-*-stat-log",
        "postgresql-*-tablelog",
        "postgresql-*-toastinfo",
        "postgresql-pltcl-*"
      ],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ SQL versions in this image cannot all be updated by a verified package-version extraction rule. Before merging, inspect every shipped extension control file and SQL upgrade script, including independently versioned bundled extensions. Update metadata.hcl, README.md and affected test expectations where needed. Do not infer SQL versions from the package version or approve solely because CI passed."
      ]
    }
  ]
}
