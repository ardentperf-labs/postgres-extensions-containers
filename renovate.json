{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "customManagers:githubActionsVersions",
    ":gitSignOff",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "ignorePaths": [],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "updates the deb package versions in the metadata.hcl files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/*.hcl"
      ],
      "matchStrings": [
        "\\/\\/\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*(sql|package)\\s*=\\s*\"(?<currentValue>.*)\""
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the container image versions in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?\\s*reference: ghcr.io\\/cnpg-extensions\\/[A-Za-z0-9_-]+:(?<currentValue>(?:[0-9]+-)?([0-9]\\.?)+)"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb",
      "currentValueTemplate": "{{{replace '-' ':' currentValue}}}",
      "extractVersionTemplate": "^(?<version>[^-+~]+)",
      "autoReplaceStringTemplate": "{{{replace (replace ':' '-' currentValue) (replace ':' '-' newValue) replaceString}}}"
    },
    {
      "description": "updates the container image SQL version in the README.md files",
      "customType": "regex",
      "managerFilePatterns": [
        "**/README.md"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*?(suite=(?<suite>.*?))?\\s*depName=(?<depName>.*?)?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s*version: '(?<currentValue>([0-9]\\.?)+)'"
      ],
      "registryUrlTemplate": "https://download.postgresql.org/pub/repos/apt?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main&binaryArch=amd64",
      "datasourceTemplate": "deb"
    },
    {
      "description": "updates the Taskfile, test files and GitHub Actions workflow dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "Taskfile.yml",
        ".github/workflows/*.yml",
        "**/test/*.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:]+\\s*:\\s*[\"']?(?:[a-zA-Z0-9._\/-]+:)?(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    },
    {
      "description": "updates the dagger dependencies",
      "customType": "regex",
      "managerFilePatterns": [
        "dagger/**/*.go"
      ],
      "matchStrings": [
        "\\/\\/\\s+renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))\\s+\\/\\/\\s+\\+default=[\\\"']?[^:]+?:(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[0-9a-f]+))?[\"']?\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "require manual review for mysql-fdw updates",
      "matchPackageNames": [
        "postgresql-18-mysql-fdw"
      ],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ Current MySQL FDW SQL extension version is 1.2. It changed from 1.1 to 1.2 on October 14, 2022 (first included in package version 2.9.0). Manually check the upstream repository to see whether the SQL extension version changed before merging this package update. If it changed, manually update mysql-fdw/README.md, mysql-fdw/metadata.hcl, and renovate.json."
      ]
    },
    {
      "description": "require manual review for pldebugger updates",
      "matchPackageNames": [
        "postgresql-18-pldebugger"
      ],
      "automerge": false,
      "prBodyNotes": [
        "⚠️ Current PL/Debugger SQL extension version is 1.1. It changed from 1.0 to 1.1 on June 25, 2018 (first included in upstream release v1.3). The Debian package version is currently 1:1.10. Renovate updates the package and image references only. Manually check the upstream repository to see whether the SQL extension version changed before merging this package update. If it changed, manually update pldebugger/README.md, pldebugger/metadata.hcl, and renovate.json."
      ]
    },
    {
      "description": "require stable release verification for all updates",
      "matchPackageNames": [
        "*"
      ],
      "prBodyNotes": [
        "⚠️ Before approving this PR, confirm that the new extension version is a stable release, not a beta or release candidate."
      ]
    },
    {
      "matchDatasources": [
        "github-tags"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "major",
        "minor",
        "patch"
      ],
      "groupName": "all github action",
      "pinDigests": true
    },
    {
      "description": "require SQL version review for approved extensions with independently versioned SQL",
      "matchPackageNames": [
        "postgresql-18-asn1oid",
        "postgresql-18-credcheck",
        "postgresql-18-dirtyread",
        "postgresql-18-first-last-agg",
        "postgresql-18-http",
        "postgresql-18-icu-ext",
        "postgresql-18-ip4r",
        "postgresql-18-jsquery",
        "postgresql-18-mongo-fdw",
        "postgresql-18-numeral",
        "postgresql-18-ogr-fdw",
        "postgresql-18-orafce",
        "postgresql-18-periods",
        "postgresql-18-pg-background",
        "postgresql-18-pg-csv",
        "postgresql-18-pg-gvm",
        "postgresql-18-pg-permissions",
        "postgresql-18-pg-wait-sampling",
        "postgresql-18-pgfincore",
        "postgresql-18-pglogical",
        "postgresql-18-pgnodemx",
        "postgresql-18-pgpcre",
        "postgresql-18-pgtt",
        "postgresql-18-pllua",
        "postgresql-18-plsh",
        "postgresql-18-prefix",
        "postgresql-18-preprepare",
        "postgresql-18-prioritize",
        "postgresql-18-rdkit",
        "postgresql-18-roaringbitmap",
        "postgresql-18-rum",
        "postgresql-18-stat-log",
        "postgresql-18-statviz",
        "postgresql-18-tablelog",
        "postgresql-18-unit",
        "postgresql-plperl-18",
        "postgresql-plpython3-18",
        "postgresql-pltcl-18"
      ],
      "automerge": false,
      "prBodyNotes": [
        "The SQL extension versions in this image do not track the full upstream package version (including independently versioned bundled extensions). Before merging, inspect the new package control files and SQL upgrade scripts, and update the extension metadata.hcl, README.md and affected test expectations where needed. Do not infer SQL versions from the package version or approve solely because CI passed."
      ]
    },
    {
      "description": "require SQL version review for documentdb updates",
      "matchPackageNames": [
        "postgresql-18-documentdb"
      ],
      "automerge": false,
      "prBodyNotes": [
        "DocumentDB package 1.0~RC1 ships SQL version 1.0-0. Before merging, inspect all shipped control files and SQL upgrade scripts, and update metadata.hcl, README.md and affected test expectations where needed. Do not infer SQL versions from the package version or approve solely because CI passed. See docs/extension-stack/sql-version-review.md."
      ]
    }
  ]
}
