/* COUNT_TIES / AVG_RANK */
SELECT part, val,
       rank()       OVER w AS rank,
       dense_rank() OVER w AS dense_rank,
       count_ties() OVER w AS count_ties,
       avg_rank()   OVER w AS avg_rank
FROM things
WINDOW w AS (PARTITION BY part ORDER BY val)
ORDER BY part, val, ord;
